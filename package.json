{
  "name": "@ocavue/eslint-config",
  "type": "module",
  "version": "4.14.0",
  "packageManager": "pnpm@11.20.0",
  "description": "Opinionated ESLint config preset",
  "author": "ocavue <ocavue@gmail.com>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/ocavue",
  "homepage": "https://github.com/ocavue/eslint-config#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/ocavue/eslint-config.git"
  },
  "bugs": "https://github.com/ocavue/eslint-config/issues",
  "keywords": [
    "eslint",
    "eslint-config",
    "typescript",
    "markdown",
    "react",
    "vue"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "vitest",
    "build": "tsc -b",
    "fix": "pnpm run fix:eslint && pnpm run fix:oxfmt",
    "fix:eslint": "eslint --fix .",
    "fix:oxfmt": "oxfmt",
    "lint": "pnpm run lint:ts && pnpm run lint:eslint && pnpm run lint:knip && pnpm run lint:oxfmt",
    "lint:eslint": "eslint .",
    "lint:oxfmt": "oxfmt --check",
    "lint:ts": "tsc -b .",
    "lint:knip": "knip",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint-react/eslint-plugin": "^5.14.1",
    "@eslint/markdown": "^8.0.3",
    "@unocss/eslint-config": "^66.8.1",
    "eslint-config-flat-gitignore": "^2.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-antfu": "^3.2.3",
    "eslint-plugin-command": "^4.0.0",
    "eslint-plugin-jsdoc": "^64.0.1",
    "eslint-plugin-no-only-tests": "^3.4.0",
    "eslint-plugin-package-json": "^1.6.0",
    "eslint-plugin-perfectionist": "^5.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-regexp": "^3.1.1",
    "eslint-plugin-unicorn": "^74.0.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.9.0",
    "typescript-eslint": "^8.66.0",
    "vue-eslint-parser": "^10.4.1"
  },
  "devDependencies": {
    "@ocavue/tsconfig": "^0.7.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.7.0",
    "jiti": "^2.7.0",
    "knip": "^6.26.0",
    "oxfmt": "^0.65.0",
    "pkg-pr-new": "^0.0.88",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
